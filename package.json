{
  "name": "monett-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for NestJS Backend, Expo Mobile/Web, and Shared Types",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "dev:backend": "npm run start:dev --workspace=@monett/backend",
    "dev:mobile": "npm run start --workspace=@monett/mobile-web",
    "android": "npm run android --workspace=@monett/mobile-web",
    "ios": "npm run ios --workspace=@monett/mobile-web",
    "build:backend": "npm run build --workspace=@monett/backend",
    "build:shared": "npm run build --workspace=@monett/shared",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
